# Restaurant reservation agent local secrets.
# Copy to .env and fill in the values you want enabled for the demo.

# Core LLM. Gemini has a free tier; keep this server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional direct Yelp fallback. Apify can cover discovery for the main demo.
# Yelp docs require Authorization: Bearer <API_KEY>.
YELP_API_KEY=
YELP_API_BASE_URL=https://api.yelp.com/v3
YELP_CACHE_TTL_SECONDS=86400

# Apify. Use this for cached restaurant discovery and reservation availability actors.
APIFY_TOKEN=
APIFY_API_BASE_URL=https://api.apify.com/v2
APIFY_GOOGLE_MAPS_ACTOR=compass/crawler-google-places
APIFY_YELP_ACTOR=junipr/yelp-scraper
APIFY_TRIPADVISOR_ACTOR=REDACTED
APIFY_RESY_ACTOR=clearpath/resy-api
APIFY_OPENTABLE_ACTOR=canadesk/opentable
APIFY_OPENTABLE_BOOKER_MCP_URL=https://clearpath--opentable-booker.apify.actor/mcp
APIFY_RESY_BOOKER_MCP_URL=https://clearpath--resy-booker.apify.actor/mcp
APIFY_MAX_RUN_CHARGE_USD=10
ALLOW_APIFY_LIVE_RUN=false
ALLOW_BROWSER_USE_LIVE_TASK=false

# Browser Use Cloud. Required for Browser Use SDK/API and hosted MCP.
BROWSER_USE_API_KEY=
BROWSER_USE_API_BASE_URL=https://api.browser-use.com/api/v3
BROWSER_USE_MCP_URL=https://api.browser-use.com/v3/mcp

# AgentPhone. Required for real SMS/voice calls.
AGENTPHONE_API_KEY=
AGENTPHONE_BASE_URL=https://api.agentphone.ai
AGENTPHONE_AGENT_ID=
AGENTPHONE_AGENT_NAME=Table Agent Reservation Caller
AGENTPHONE_NUMBER_ID=
AGENTPHONE_FROM_NUMBER=
AGENTPHONE_WEBHOOK_SECRET=
AGENTPHONE_AUTO_CREATE_AGENT=true
RESTAURANT_CALL_TEST_OVERRIDE_PHONE=

# AgentMail. Required for real email confirmation and inbound email handling.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=

# Supermemory. Optional for MVP, useful for user preferences.
SUPERMEMORY_API_KEY=
SUPERMEMORY_USER_ID=demo-user
SUPERMEMORY_PROJECT_ID=restaurant-reservation-agent

# Demo/runtime safety toggles.
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
DEMO_LOCATION=REDACTED, San Francisco, CA
DEMO_TIMEZONE=America/Los_Angeles
DEMO_TEST_RECIPIENT_EMAIL=
DEMO_TEST_RECIPIENT_PHONE=
ALLOW_REAL_RESTAURANT_CALLS=false
ALLOW_REAL_SMS_SEND=false
ALLOW_REAL_EMAIL_SEND=false
ALLOW_REAL_BOOKING_SUBMIT=false
